# Copy to .env.local and edit. Do not commit .env.local.
REMOTE_HOST=CHANGE_ME_USER@CHANGE_ME_HOST
REMOTE_WORKDIR=.local/share/claude-code-sec-vm
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

# Required only when exposing desktop ports on the remote host LAN.
# Keep real LAN values in .env.local only.
# HOST_VNC_BIND=CHANGE_ME_HOST_LAN_IP
# HOST_VNC_ALLOW_CIDR=CHANGE_ME_ALLOWED_CLIENT_CIDR

# Optional: allow Kali to directly reach host-side 192.168.0.0/24 only.
# ALLOW_KALI_192_168_0_24=1

# VM resources
DEV_VM_CPU=4
DEV_VM_MEMORY_MB=8192
DEV_VM_DISK_GB=80

# Images. DEV_IMAGE_URL=auto resolves the current official Kali genericcloud amd64 tarball.
DEV_IMAGE_URL=auto

# Optional: override the sing-box official Debian install script URL.
SING_BOX_INSTALL_SCRIPT_URL=https://sing-box.app/deb-install.sh

# Egress-check endpoint. It is used only for reachability, not for trusting geolocation.
FOREIGN_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace

# Optional: endpoint used by `make foreign-clean-refresh` to derive timezone
# from the current foreign_clean exit IP. It may return JSON with a `timezone`
# field or a plain IANA timezone string.
FOREIGN_TIMEZONE_URL=https://ipapi.co/json/
